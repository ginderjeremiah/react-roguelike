# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# test output
playwright-report/
test-results/
blob-report/
.playwright/
coverage/

# claude code local overrides (shared settings.json IS committed)
.claude/settings.local.json
# agent git worktrees — full repo copies, must never be committed or scanned
.claude/worktrees/

app-example

# generated native folders
/ios
/android

# playtest/inspection screenshots — take them, look at them, do not commit them
shot-*.png

# The `playtester` agent's scratch directory: the driver script it writes to drive the built app,
# and the shots it takes. `shot-*.png` above covers the images and nothing covered the rest, so a
# routine `git add -A` after the mandated playtest gate would commit a throwaway harness. Ignored
# as a directory rather than by extension because what lands here is the agent's choice, not ours.
.playtest/
